{
  "manifest_version": 3,
  "name": "Flow",
  "version": "0.1.0",
  "description": "Enforces URL-path rules the network layer cannot see, and closes tabs that were already open when a session started.",
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "flow@lushenwar.github.io",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Flow"
  }
}
